# ---- Server (never exposed to the browser) ----
NODE_ENV=development
# Public origin of this deployment; used for absolute share/OG URLs
APP_ORIGIN=http://localhost:3000
# Required by Nominatim's usage policy once geocoding is wired up (Phase 4)
GEOCODE_CONTACT_EMAIL=
# Neon Postgres: Dashboard > Connect > "Pooled connection" (host contains -pooler)
# e.g. postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/festly?sslmode=require
# Any local Postgres works too: postgresql://postgres:postgres@localhost:5432/festly
DATABASE_URL=
# Until auth (Phase 5) drafts belong to a fixed dev user; on by default outside
# production. Never enable on a real deployment.
ALLOW_DEV_USER=false

# ---- Client (VITE_* only; anything here ships to the browser) ----
VITE_APP_NAME=Festly
# Google Maps Embed API key (free, unlimited). Restrict by HTTP referrer.
VITE_GOOGLE_MAPS_EMBED_KEY=
# Set to true to keep /dev/* routes reachable in a production build
VITE_ENABLE_DEV_ROUTES=false

# Added in later phases (after provider decisions):
# STORAGE_*                # Phase 4
# BETTER_AUTH_SECRET=      # Phase 5
